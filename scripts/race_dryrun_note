#!/usr/bin/env python3
"""无扩展名入口：等价于 python scripts/race_dryrun_note.py。

题面要求的双请求争用脚本名 race_dryrun_note；真正实现见同目录
race_dryrun_note.py。这样 `python scripts/race_dryrun_note` 与
`./scripts/race_dryrun_note` 两种调法都可用。
"""
import runpy
import sys
from pathlib import Path

_target = Path(__file__).resolve().with_name("race_dryrun_note.py")
sys.argv[0] = str(_target)
runpy.run_path(str(_target), run_name="__main__")
